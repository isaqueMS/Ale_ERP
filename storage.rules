rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in [
          '7185062361@estudioale.com',
          'admin@estudioale.com',
          'alexandra@estudioale.com'
        ] ||
        (
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // Fotos de produtos e de profissionais: leitura para qualquer autenticado,
    // escrita (upload/remoção) só para admin — espelha as regras do Firestore.
    match /products/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
